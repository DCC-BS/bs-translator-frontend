# Runtime variables (used during application execution)
# @defaultSensitive=false
# @import(./.env.dev.schema, enabled=eq($APP_MODE, "dev"))
# ---

# @optional @type=port
API_PORT=8000

# API base URL
# @public @type=url @required=not($DUMMY)
NUXT_API_URL=if(
    eq($APP_MODE, dev),
    http://localhost:${API_PORT},
)

# GitHub token for feedback feature
# @sensitive @required=$USE_FEEDBACK
NUXT_FEEDBACK_GITHUB_TOKEN=

# Use dummy data (default: false)
# @type=boolean
DUMMY=eq($APP_MODE, ci)

# Log level of the server and browser logger (default: debug in dev, info otherwise)
# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=ifs(
    eq($APP_MODE, dev), debug,
    info
)

# Runtime override of runtimeConfig.public.logger.loglevel (defaults to LOG_LEVEL)
# @public @type=enum(trace, debug, info, warn, error, fatal)
NUXT_PUBLIC_LOGGER_LOGLEVEL=$LOG_LEVEL

# Disables the Changelogs flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_CHANGELOG=eq($APP_MODE, ci)

# Disables the Disclaimer flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_DISCLAIMER=eq($APP_MODE, ci)

# Disables the Onboarding flow
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_ONBOARDING=eq($APP_MODE, ci)

# Disables the <SystemStatus> health indicator
# @type=boolean
NUXT_PUBLIC_COMMON_UI_DISABLE_SYSTEM_STATUS=eq($APP_MODE, ci)

# URL template for the app switcher links, {APP_NAME} is replaced by the app slug
# (required in prod, e.g. https://{APP_NAME}.example.ch)
# @type=string @required=eq($APP_MODE, prod)
NUXT_PUBLIC_APP_CONFIG_APP_LIST_URL_TEMPLATE=if(
    not(eq($APP_MODE, prod)), "http://{APP_NAME}.localhost.ch",
)
