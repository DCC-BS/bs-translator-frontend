# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @plugin(@varlock/proton-pass-plugin@0.0.3)
# @initProtonPass()
# @defaultRequired=true @defaultSensitive=false
# @import(../.env.buildtime.schema)
#  ----------

# The cache directory for storing huggingface models
CACHE_DIR="~/.cache"

# @type=boolean
IS_PROD=false

# Hugging face token for downloading the models
# @sensitive
HUGGING_FACE_HUB_TOKEN=protonPass(`pass://DCC-KI/HUGGING_FACE_TOKEN/TOKEN`)

HUGGING_FACE_CACHE_DIR=${CACHE_DIR}/huggingface

# Base url for the llm calls (OpenAI compatible, container-internal)
# @type=url
LLM_URL=http://llm:8000/v1

# LLM Key for authentication
# @sensitive
LLM_API_KEY=none-llm-key

# Model name
LLM_MODEL="Qwen/Qwen3-32B-AWQ"

# @type=url
LLM_HEALTH_CHECK_URL=http://llm:8000/health

# Generate with openssl rand -base64 32
# @required @sensitive
HMAC_SECRET=

# @type=enum(debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Upload limit enforced by the backend (413 above it).
# Keep client_max_body_size in nginx.conf slightly above this value.
# @type=number
MAX_UPLOAD_SIZE_MB=50

# docling-serve OCR preset for photo translation (served by vllm-glm-ocr)
DOCLING_IMAGE_OCR_PRESET=glm-ocr-remote

# docling-serve layout preset for photo translation
DOCLING_IMAGE_LAYOUT_PRESET=ppdoclayout-v3

# Text blocks of one photo translated in parallel
# @type=number
IMAGE_TRANSLATION_CONCURRENCY=4

## Frontend

# Build the frontend with the feedback control (needs NUXT_FEEDBACK_GITHUB_TOKEN)
# @type=boolean
USE_FEEDBACK=false

# GitHub token for the feedback control
# @sensitive @required=$USE_FEEDBACK
NUXT_FEEDBACK_GITHUB_TOKEN=

# URL template for the app switcher links, {APP_NAME} is replaced by the app slug
NUXT_PUBLIC_APP_CONFIG_APP_LIST_URL_TEMPLATE="http://{APP_NAME}.localhost.ch"

## Host ports

# @type=port
CLIENT_PORT=3000

# @type=port
DOCLING_PORT=8004

# @type=port
WHISPER_PORT=50001

## Service URLs (container-internal ports, not the host ports above)

# @type=url
CLIENT_URL=http://localhost:${CLIENT_PORT}

# @type=url
DOCLING_URL=http://docling:5001/v1

# The api key for docling (docling-serve ignores it unless DOCLING_SERVE_API_KEY is set)
# @sensitive
DOCLING_API_KEY=none

# @type=url
WHISPER_URL=http://faster_whisper:50001/v1
